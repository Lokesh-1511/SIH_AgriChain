# AGRICHAIN Backend Environment Configuration
# Copy this file to .env and update with your actual values

# UIDAI/KUA API Configuration
UIDAI_BASE_URL=https://sandbox.uidai.gov.in
KUA_API_KEY=your_kua_api_key_here
KUA_SECRET=your_kua_secret_here

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=agrichain_db

# Security Configuration
ENCRYPTION_KEY=generate_new_fernet_key_here
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting Configuration
MAX_OTP_REQUESTS_PER_DAY=5
OTP_EXPIRY_MINUTES=10

# Redis Configuration (for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/agrichain_backend.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=AGRICHAIN Aadhaar Verification Service
API_VERSION=1.0.0

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true