# AgriChain Backend Environment Configuration# AGRICHAIN Backend Environment Configuration

# Copy this file to .env and update with your actual values# Copy this file to .env and update with your actual values



# Server Configuration# UIDAI/KUA API Configuration

PORT=3000UIDAI_BASE_URL=https://sandbox.uidai.gov.in

NODE_ENV=developmentKUA_API_KEY=your_kua_api_key_here

KUA_SECRET=your_kua_secret_here

# Aadhaar Validation Rules

ALLOWED_AADHAAR_PATTERNS=123456*,999999*,555555*,789012*# MongoDB Configuration

MIN_AADHAAR_LENGTH=12MONGODB_URL=mongodb://localhost:27017

MAX_AADHAAR_LENGTH=12DATABASE_NAME=agrichain_db



# OTP Configuration# Security Configuration

OTP_LENGTH=6ENCRYPTION_KEY=generate_new_fernet_key_here

OTP_EXPIRY_MINUTES=10JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

MAX_OTP_ATTEMPTS=3JWT_ALGORITHM=HS256

OTP_RETRY_DELAY_SECONDS=30JWT_EXPIRATION_HOURS=24



# Rate Limiting# Rate Limiting Configuration

MAX_REQUESTS_PER_WINDOW=10MAX_OTP_REQUESTS_PER_DAY=5

RATE_LIMIT_WINDOW_MINUTES=15

# SMS Configuration

# Security# Choose your SMS provider: twilio, textlocal, msg91, fast2sms, mock

JWT_SECRET=your_jwt_secret_key_change_in_productionSMS_PROVIDER=mock

ENCRYPTION_KEY=your_encryption_key_32_characters

# Twilio Configuration (International SMS)

# CORS ConfigurationTWILIO_ACCOUNT_SID=your_twilio_account_sid

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000TWILIO_AUTH_TOKEN=your_twilio_auth_token  

TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Logging

LOG_LEVEL=info# TextLocal Configuration (Indian SMS Provider)

ENABLE_REQUEST_LOGGING=trueTEXTLOCAL_API_KEY=your_textlocal_api_key

TEXTLOCAL_SENDER=AGRICH

# Mock SMS Configuration

SMS_PROVIDER=mock# MSG91 Configuration (Popular in India)

SMS_FROM_NUMBER=+1234567890MSG91_AUTH_KEY=your_msg91_auth_key

MSG91_SENDER_ID=AGRICH

# Development Features

ENABLE_DEBUG_ROUTES=true# Fast2SMS Configuration (Indian Provider)

MOCK_AADHAAR_DATABASE=trueFAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=AGRICH
OTP_EXPIRY_MINUTES=10

# Redis Configuration (for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/agrichain_backend.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=AGRICHAIN Aadhaar Verification Service
API_VERSION=1.0.0

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true