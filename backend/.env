# AGRICHAIN Backend Environment Configuration

PORT=3000
NODE_ENV=development

# Aadhaar Validation Patterns (for development/testing)
# ALL possible Aadhaar starting patterns - covers complete UIDAI number range
# This allows any valid Aadhaar format for conceptual testing
ALLOWED_AADHAAR_PATTERNS=2*,3*,4*,5*,6*,7*,8*,9*

# UIDAI/KUA API Configuration
UIDAI_BASE_URL=https://sandbox.uidai.gov.in
KUA_API_KEY=your_kua_api_key_here

KUA_SECRET=your_kua_secret_here

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=3
OTP_RETRY_DELAY_SECONDS=30

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=agrichain_db

# Rate Limiting Configuration
MAX_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_MINUTES=15

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=dev_encryption_key_32_chars_long!
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Development Features
ENABLE_DEBUG_ROUTES=true
MOCK_AADHAAR_DATABASE=true

# SMS Configuration - For Development/Demo
SMS_PROVIDER=mock
SMS_FROM_NUMBER=+1234567890
MAX_OTP_REQUESTS_PER_DAY=5

# For testing with real SMS, configure one of these:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token  
# TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/agrichain_backend.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=AGRICHAIN Aadhaar Verification Service
API_VERSION=1.0.0

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true