# Environment configuration for Admin Dashboard backend
PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrichain
# For production / Atlas use a full SRV connection string. NEVER commit real credentials.
# Example (replace user, password):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster-akr.pqejowl.mongodb.net/agrichain_db?retryWrites=true&w=majority&appName=Cluster-AKR
# If using the provided Flutter connection values, move them to a real .env (not committed):
# MONGODB_URI=mongodb+srv://karthikrajaanand12:YOUR_PASSWORD@cluster-akr.pqejowl.mongodb.net/agrichain_db?retryWrites=true&w=majority&appName=Cluster-AKR
JWT_SECRET=replace-with-strong-secret
LOG_LEVEL=info
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Firebase (for future server-side token verification / admin SDK)
# Provide service account via GOOGLE_APPLICATION_CREDENTIALS or use these to validate ID token audience.
FIREBASE_PROJECT_ID=agri-chain-sih
FIREBASE_MESSAGING_SENDER_ID=797432400385
FIREBASE_STORAGE_BUCKET=agri-chain-sih.firebasestorage.app
