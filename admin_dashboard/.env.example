# Environment Configuration for Admin Dashboard

# Development Environment
VITE_APP_NAME=AgriChain Admin Dashboard
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

VITE_API_BASE_URL=http://localhost:5000/api

# Smart Contract Addresses (Replace with your actual contract addresses)
VITE_SUPPLY_CHAIN_CONTRACT=0x1234567890123456789012345678901234567890
VITE_TOKEN_CONTRACT=0x0987654321098765432109876543210987654321

# Feature Flags (UI only)
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# Single-admin mode: credentials embedded in code (AuthContext)
# To enable backend-authenticated stats, run in backend folder:
#   npm run seed:admin  (creates verified administrator)